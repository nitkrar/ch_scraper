	   td.grandtotal-no-top-border,
	   th.figure {
	       vertical-align: middle;
	       text-align: right;
	       white-space: nowrap;
	       width: 14%;
	   }
	   td.description {
	       width: 50%;
	   }
	   td.total {
	       border-top: black solid 1px;
	       border-bottom: black solid 1px;
	   }
	   td.total-no-top-border {
	       border-bottom: black solid 1px;
	   }
	   td.grandtotal-no-top-border {
	       border-bottom: black double 3px;
	   }
	   td.grandtotal {
	       border-top: black solid 1px;
	       border-bottom: black double 3px;
	   }
	   td.align-right {
	       text-align: right;
	   }
	   @media print {
	       td.figure,
	       td.total,
	       td.total-no-top-border,
	       td.grandtotal,
	       td.total-no-top-border,
